{
    "name": "blackiya",
    "description": "Chrome extension to capture and export conversations from ChatGPT and other LLMs",
    "private": true,
    "version": "3.0.1",
    "type": "module",
    "author": "Ragaeeb Haq",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ragaeeb/blackiya.git"
    },
    "bugs": {
        "url": "https://github.com/ragaeeb/blackiya/issues"
    },
    "homepage": "https://github.com/ragaeeb/blackiya#readme",
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=25.0.0"
    },
    "packageManager": "bun@1.4.0",
    "scripts": {
        "dev": "BLACKIYA_BUILD_PROFILE=dev wxt",
        "dev:firefox": "BLACKIYA_BUILD_PROFILE=dev wxt -b firefox",
        "build": "BLACKIYA_BUILD_PROFILE=prod tsc --noEmit && wxt build",
        "build:firefox": "BLACKIYA_BUILD_PROFILE=prod bun run check && tsc --noEmit && wxt build -b firefox",
        "zip": "tsc --noEmit && wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "compile": "tsc --noEmit",
        "postinstall": "wxt prepare",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "har:analyze": "bun run scripts/analyze-har.ts",
        "lint": "biome lint .",
        "format": "biome format --write . && biome check . --write"
    },
    "dependencies": {
        "preact": "^10.29.8"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.11",
        "@happy-dom/global-registrator": "^20.12.0",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.9",
        "@semantic-release/npm": "^13.1.5",
        "@types/bun": "^1.4.0",
        "@types/har-format": "^1.2.16",
        "happy-dom": "^20.12.0",
        "semantic-release": "^25.0.9",
        "typescript": "^7.0.2",
        "wxt": "^0.21.4"
    }
}
